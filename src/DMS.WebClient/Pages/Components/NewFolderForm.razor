@using Shared.Requests

<div style="margin: 1rem;">

    <EditForm Model="folder" OnValidSubmit="OnValidSubmitAsync">
        <DataAnnotationsValidator />
        <MudText Typo="Typo.h6" GutterBottom="true">Create New Folder</MudText>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="folder.Name" Label="Folder Name" Variant="Variant.Outlined" FullWidth="true" />
                <ValidationMessage For="@(() => folder.Name)" />
            </MudItem>
            <MudItem xs="12">
                <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled">Create</MudButton>
            </MudItem>
        </MudGrid>

    </EditForm>
</div>

@code {
    CreateFolder folder = new();

    [CascadingParameter(Name = "SubscriptionId")]
    public Guid SubscriptionId { get; set; }

    async Task OnValidSubmitAsync()
    {
        var fileDetails = await _fileProvider.CreateFolderAsync(SubscriptionId, folder);
        // Handle form submission logic here
        // var client = _httpClientFactory.CreateClient()
    }
}
