
<div style="margin: 1rem;">
    <EditForm Model="Container" OnValidSubmit="OnValidSubmitAsync">
        <DataAnnotationsValidator />
        <MudText Typo="Typo.h6" GutterBottom="true">New Container</MudText>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="Container.Name" Label="Container Name" Variant="Variant.Outlined" FullWidth="true" />
                <ValidationMessage For="@(() => Container.Name)" />
                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudText Color="Color.Error" HtmlTag="div">@_errorMessage</MudText>
                }
            </MudItem>
             <MudItem xs="12">
                <MudStack Row="true" AlignItems="AlignItems.End" Justify="Justify.FlexEnd">
                    <MudButton ButtonType="ButtonType.Button" Color="Color.Primary" Variant="Variant.Text" OnClick="@(() => MudDialog.Cancel())">Cancel</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="_submitting">Create</MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </EditForm>
</div>


@code {

    bool _submitting = false;
    CreateContainer Container = new();

    [Parameter]
    public Guid SubscriptionId { get; set; }

    [Parameter]
    public Guid? ContainerId { get; set; }

    [Parameter]
    public Guid UserId { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    string _errorMessage = string.Empty;

    async Task OnValidSubmitAsync()
    {
        _submitting = true;
        _errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            if (ContainerId.HasValue)
            {
                Container.ParentId = ContainerId.Value;
            }

            var fileDetails = await _fileProvider.CreateContainerAsync(UserId, SubscriptionId, Container);
            
            MudDialog.Close(fileDetails);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        _submitting = false;
        StateHasChanged();
    }
}
