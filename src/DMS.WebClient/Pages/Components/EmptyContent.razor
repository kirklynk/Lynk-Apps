<MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Style="font-size: 1.5rem; color: #999; font-weight: 300; height: 100%;">
    @if (ChildContent != null)
    {
        @ChildContent

    }
    else
    {
        <text>No results found</text>
    }

</MudStack>


@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; } 

}
