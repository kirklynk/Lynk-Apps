@using System.Dynamic

<MudDataGrid T="LynkFileInfo" Bordered="false"
             FixedHeader="true"
             Virtualize="true"
             Outlined="false"
             ItemSize="36.0f"
             SortMode="SortMode.Single"
             Height="500px"
             VirtualizeServerData="GetData" RowClick="RowClicked" @ref="_dataGrid">

    <Columns>
        <TemplateColumn CellStyle="width: 24px;">
            <CellTemplate>
                @if (context.Item.IsFolder)
                {
                    <img src="images/folder.svg" alt="Folder" style="width:24px;height:24px;" />
                }
                else
                {
                    <span>&nbsp;</span>
                }
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Name" SortBy="x => x.IsFolder" />
        <PropertyColumn Property="x => x.ModifiedOn" SortBy="x => x.IsFolder" />
        <TemplateColumn CellStyle="width: 24px;">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center">
            This area has no content.
        </MudStack>
    </NoRecordsContent>
</MudDataGrid>

@code {

    [Parameter]
    public Guid? FolderId { private get; set; }

    [CascadingParameter(Name = "SubscriptionId")]
    public Guid SubscriptionId { get; set; }

    FileUploads _uploads = new FileUploads();
    MudFileUpload<IReadOnlyList<IBrowserFile>>? _fileUploader;
    MudDataGrid<LynkFileInfo>? _dataGrid;
    bool _isRendered = false;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
    }

    public class FileUploads
    {
        public IReadOnlyList<IBrowserFile>? Files { get; set; } = new List<IBrowserFile>();
    }


    async Task RowClicked(DataGridRowClickEventArgs<LynkFileInfo> args)
    {
        var item = args.Item;
        // Handle the row click event, e.g., navigate to the file details page
        if (item.IsFolder)
        {
            // Navigate to folder view
            _navigationManager.NavigateTo($"/view/1/{item.Id}");
        }
        else
        {
            // Open or download the file
        }
    }

    public async Task RefreshAsync(Guid folderId)
    {
        FolderId = folderId;
        if (_dataGrid != null)
        {
            await _dataGrid.ReloadServerData();
            await InvokeAsync(() =>
            {
                StateHasChanged();
            });
        }
    }

    async Task<GridData<LynkFileInfo>> GetData(GridStateVirtualize<LynkFileInfo> request, CancellationToken token)
    {
        try
        {
            await Task.Delay(1000, token);
            var sort = request.SortDefinitions.FirstOrDefault();
            var query = await _fileProvider.QueryAsync(SubscriptionId, FolderId, request.StartIndex, request.Count, search: null);//.GetFilesAsync(SubscriptionId, FolderId, request.StartIndex, request.Count, sort?.SortBy, sort != null ? !sort.Descending : (bool?)null);

            return new GridData<LynkFileInfo>
            {
                Items = query.Items,
                TotalItems = query.TotalCount
            };
        }
        catch (Exception ex)
        {

        }

        return new GridData<LynkFileInfo>
        {
            Items = [],
            TotalItems = 0
        };
    }
}
