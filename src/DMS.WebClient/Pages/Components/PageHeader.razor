<PageTitle>Lynk DMS @(string.IsNullOrEmpty(Title) ? "" : $" - {Title}")</PageTitle>
<MudPaper Elevation="0" Style="margin-bottom: 5px;">
    @HeaderContent
</MudPaper>

<MudPaper Elevation="2" Class="px-2 py-2 mb-6">
    @ChildContent
</MudPaper>

@code {

    [Parameter, EditorRequired]
    public string? Title { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment? HeaderContent { get; set; }
}
