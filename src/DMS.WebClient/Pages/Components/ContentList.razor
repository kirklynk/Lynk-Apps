@using System.Dynamic
@using MudBlazor
@inject ILogger<ContentList> _logger

@inject IHttpClientFactory _factory
<PageTitle>DMS - @(_container?.Name ?? $"My Files")</PageTitle>

<div>
    <MudBreadcrumbs Items="_breadcrumbs" />
</div>

<MudText HtmlTag="h2" Style="font-size: 1.5rem; margin-bottom: 1rem;">
    @(_container?.Name ?? $"My Files")
</MudText>

<div style="margin-bottom: .5rem;">
    <MudMenu Style="padding: 0.5rem; width: 100%;" AnchorOrigin="Origin.BottomLeft" Color="Color.Primary">
        <ActivatorContent>
            <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Medium" Label="Create or upload" />
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem Label="New Container" Icon="@Icons.Material.Filled.Folder" OnClick="OpenNewContainerDialogAsync" />
            <MudMenuItem Label="Upload files" Icon="@Icons.Material.Filled.UploadFile" OnClick="@(async args => await OpenFileUploaderAsync(ContainerId))" />
        </ChildContent>
    </MudMenu>

    <input type="file" style="display:none" id="lynk-file-upload" @ref="_fileInput" @onchange="FileInputChanged" multiple />
</div>
<div>
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="false" Value="@(_percentage * 1.00)" />
</div>
<div>
    <MudDataGrid T="DocumentInfo" MultiSelection="true" Bordered="false" FixedHeader="true" Virtualize="true" Outlined="false" ItemSize="20.0f" Style="border: none !important;" SortMode="SortMode.Single" Loading="@_isLoading" Height="500px" Elevation="0" RowClass="row" VirtualizeServerData="GetDataAsync" RowClick="RowClicked" @ref="_dataGrid">
        <Columns>
            <TemplateColumn CellStyle="width: 24px;" Context="ctx">
                <CellTemplate>
                    @if (ctx.Item.IsContainer)
                    {
                        <img src="images/folder.svg" alt="Container" style="width:24px;height:24px;" />
                    }
                    else
                    {
                        <img src="images/document.svg" alt="Document" style="width:24px;height:24px;" />
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Property="x => x.Name" SortBy="x => x.IsContainer" Context="ctx">
                <CellTemplate>
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        @ctx.Item.Name
                        @if (ctx.Item.IsPinned == true)
                        {
                            <img src="images/pinned.svg" alt="Pin" title="Pinned" style="width:20px;height:20px;" />
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.ModifiedOn" SortBy="x => x.IsContainer" />
            <TemplateColumn CellStyle="width: 24px;" Context="ctx">
                <CellTemplate>
                    <MudMenu AnchorOrigin="Origin.CenterLeft" Color="Color.Primary">
                        <ActivatorContent>
                            <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" />
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem Label="Delete" Icon="@Icons.Material.Filled.Delete" OnClick="@(async () => await DeleteAsync(ctx.Item.Id))" />

                            <MudMenuItem Label="Rename" Icon="@Icons.Material.Filled.TextFields" />

                            <MudMenuItem Label="Share" Icon="@Icons.Material.Filled.Share" OnClick="@(async () => await ShareAsync(ctx.Item))" />

                            <MudMenuItem Label="@(ctx.Item.IsPinned == true ? "Unpin" : "Pin")" Icon="@Icons.Material.Filled.Favorite" IconColor="@(ctx.Item.IsPinned == true ? Color.Error : Color.Default)" OnClick="@(async () => await TogglePinnedAsync(ctx.Item))" />

                            @if (ctx.Item.IsContainer)
                            {
                                <MudMenuItem Label="Upload files" Icon="@Icons.Material.Filled.UploadFile" OnClick="@(async args => await OpenFileUploaderAsync(ctx.Item.Id))" />
                            }

                        </ChildContent>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <EmptyContent />
        </NoRecordsContent>
    </MudDataGrid>
</div>

<MudMessageBox @ref="_mudMessageBox" Title="Warning" CancelText="Cancel">
    <MessageContent>
        Are you sure you want to move this item to the recycle bin, you will have 30 days to recover it?
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error"> Delete</MudButton>
    </YesButton>
</MudMessageBox>

@code {

    [Parameter]
    public Guid? ContainerId { private get; set; }

    [CascadingParameter(Name = "SubscriptionId")]
    public Guid SubscriptionId { get; set; }

    [CascadingParameter(Name = "UserId")]
    public Guid UserId { get; set; }

    MudDataGrid<DocumentInfo>? _dataGrid;
    bool _isLoading = true;
    List<BreadcrumbItem> _breadcrumbs = new() { new("Root", $"/", icon: Icons.Material.Filled.Home) };

    ElementReference _fileInput;

    IJSObjectReference _uploader;
    DotNetObjectReference<ContentList>? objRef;
    DocumentInfo? _container = null;
    MudMessageBox? _mudMessageBox;
    bool _isUploading = false;
    int _percentage = 0;

    protected override async Task OnParametersSetAsync()
    {
        _container = null;
        _logger.LogInformation("OnParametersSetAsync called with ContainerId: {ContainerId}", ContainerId);
        _breadcrumbs = new() { new("", $"/view/0", icon: Icons.Material.Filled.Home) };
        if (ContainerId.HasValue)
        {
            _container = await _fileProvider.GetDocumentDetailsAsync(UserId, SubscriptionId, ContainerId.Value);
            if (_container?.Parent != null)
            {
                _breadcrumbs.Add(new(_container.Parent.Name, $"/view/1/{_container.Parent.Id}"));
            }
            _breadcrumbs.Add(new(_container.Name, $"/view/1/{_container.Id}", disabled: true));

        }
        else
        {
            _breadcrumbs = new() { new("", $"/", icon: Icons.Material.Filled.Home) };
        }
        if (_dataGrid != null)
        {
            await _dataGrid!.ReloadServerData();
        }
        await base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _logger.LogInformation("OnAfterRenderAsync firstRender: {FirstRender}", firstRender);
            _uploader ??= await _jsRuntime.InvokeAsync<IJSObjectReference>("import", "./upload.js");
            objRef ??= DotNetObjectReference.Create(this);

            // await _uploader.InvokeVoidAsync("initializeUploader", "lynk-file-upload", objRef);
        }
    }

    async Task RowClicked(DataGridRowClickEventArgs<DocumentInfo> args)
    {
        var item = args.Item;
        // Handle the row click event, e.g., navigate to the file details page
        if (item.IsContainer)
        {
            // Navigate to Container view
            _navigationManager.NavigateTo($"/view/1/{item.Id}");
        }
        else
        {
            // Open or download the file
        }
    }

    async Task<GridData<DocumentInfo>> GetDataAsync(GridStateVirtualize<DocumentInfo> request, CancellationToken token)
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var sort = request.SortDefinitions.FirstOrDefault();

            var query = await _fileProvider.QueryContentAsync(UserId, SubscriptionId, ContainerId, request.StartIndex, request.Count, search: null, orderBy: sort?.SortBy, descending: sort?.Descending ?? false, cancellationToken: token);

            return new GridData<DocumentInfo>
            {
                Items = query.Items ?? [],
                TotalItems = query.TotalCount
            };
        }
        catch (Exception ex)
        {

        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }

        return new GridData<DocumentInfo>
        {
            Items = [],
            TotalItems = 0
        };
    }

    async Task OpenNewContainerDialogAsync()
    {
        var result = await _dialogService.ShowAsync<NewContainerForm>("New Container",
            new DialogParameters<NewContainerForm>() { { x => x.SubscriptionId, SubscriptionId }, { x => x.ContainerId, ContainerId }, { x => x.UserId, UserId } },
            new DialogOptions
            {
                CloseOnEscapeKey = true,
                NoHeader = true,
                FullWidth = true,
                MaxWidth = MaxWidth.Small,
                Position = DialogPosition.Center
            });

        var fileDetails = await result.GetReturnValueAsync<DocumentInfo>();
        if (fileDetails != null)
        {
            if (_dataGrid != null)
            {
                await _dataGrid.ReloadServerData();
                StateHasChanged();
            }
        }
    }

    async Task DeleteAsync(Guid item)
    {
        if (_mudMessageBox != null)
        {
            var result = await _mudMessageBox.ShowAsync();
            if (result == true)
            {
                await _fileProvider.DeleteAsync(UserId, SubscriptionId, item);
                _snackbar?.Clear();

                _snackbar?.Add("Item deleted successfully.", Severity.Success);

                if (_dataGrid != null)
                {
                    await _dataGrid.ReloadServerData();
                }
            }
        }
        // var result = await _dialogService.ShowMessageBox("Confirm Delete", "Are you sure you want to delete this item, you will have 30 days to recover it?", yesText: "Delete", noText: "Cancel");
        // if (result == true)
        // {
        //     await _fileProvider.DeleteAsync(SubscriptionId, item);
        //     _snackbar?.Clear();
        //     _snackbar?.Add("Item deleted successfully.", Severity.Success);
        //     if (_dataGrid != null)
        //     {
        //         await _dataGrid.ReloadServerData();
        //     }
        // }
    }

    async Task TogglePinnedAsync(DocumentInfo item)
    {
        if (item.IsPinned == true)
        {
            await _fileProvider.UnpinAsync(UserId, SubscriptionId, new PinRequest { ReferenceId = item.Id, Entity = item.IsContainer ? EntityType.Container : EntityType.Document });
            item.IsPinned = false;
        }
        else
        {
            await _fileProvider.PinAsync(UserId, SubscriptionId, new PinRequest { ReferenceId = item.Id, Entity = item.IsContainer ? EntityType.Container : EntityType.Document });
            item.IsPinned = true;
        }
        _snackbar?.Clear();
        _snackbar?.Add(item.IsPinned == true ? "Item pinned successfully." : "Item unpinned successfully.", Severity.Success);
        if (_dataGrid != null)
        {
            await _dataGrid.ReloadServerData();
        }
        StateHasChanged();
    }

    private async Task OpenFileUploaderAsync(Guid? containerId)
    {
        await _uploader.InvokeVoidAsync("openFileInput", _fileInput, containerId);
        _isUploading = false;
        _percentage = 0;
        StateHasChanged();
    }

    private async Task FileInputChanged(ChangeEventArgs args)
    {
        var httpClient = _factory.CreateClient("backend");
        var uploadUrl = new Uri(httpClient.BaseAddress, $"/dms/api/users/{UserId}/subscriptions/{SubscriptionId}/documents/upload/stream");
        await _uploader.InvokeVoidAsync("uploadAsync", _fileInput, uploadUrl.ToString(), objRef);
        _isUploading = true;
        StateHasChanged();
    }

    [JSInvokable("OnUploadComplete")]
    public async Task OnUploadComplete(bool success, string message)
    {
        if (success && _dataGrid != null)
        {
            await _dataGrid.ReloadServerData();
            _snackbar?.Clear();
            _snackbar?.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
            _snackbar?.Add("File uploaded successfully.", Severity.Success);
        }
        else
        {
            await _dialogService.ShowMessageBox("Upload Failed", "File upload failed.");
        }
        _isUploading = false;
        StateHasChanged();
    }

    [JSInvokable("UpdateProgress")]
    public async Task UpdateProgress(int percentage, string file)
    {
        await InvokeAsync(() =>
        {
            _percentage = percentage;
            StateHasChanged();
            _logger.LogInformation("Upload progress for file {File}: {Percentage}%", file, percentage);
        });

    }

    private async Task ShareAsync(DocumentInfo documentInfo)
    {
        var dialog = await _dialogService.ShowAsync<ShareDialog>("Share Document",
            new DialogParameters<ShareDialog>() { { x => x.Info, documentInfo } },
            new DialogOptions
            {
                CloseOnEscapeKey = true,
                NoHeader = true,
                MaxWidth = MaxWidth.Medium,
                Position = DialogPosition.Center,
                CloseButton = true
            });
    }
}
<style>
    .row, .row > td.mud-table-row {
        border-bottom: none !important;
    }

</style>