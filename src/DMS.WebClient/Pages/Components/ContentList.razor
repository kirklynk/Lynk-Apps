@using System.Dynamic
@inject IHttpClientFactory _factory
@implements IAsyncDisposable

<div style="margin-bottom: 1rem;">
    <RadzenBreadCrumb>
        <RadzenBreadCrumbItem Path="@(ContainerId == null ? "" : "/")" Icon="home" />
        @if (_fileDetails?.Parent != null)
        {
            <RadzenBreadCrumbItem Path=@($"/view/1/{_fileDetails.Parent.Id}") Text="@_fileDetails.Parent.Name" />
        }
        @if (_fileDetails != null)
        {
            <RadzenBreadCrumbItem Text="@_fileDetails.Name" />
        }
    </RadzenBreadCrumb>
</div>

<div>
    <RadzenDataGrid Count="_count" TItem="DocumentInfo" Data="_items" Style="height: 600px;" AllowVirtualization="true" LoadData="GetDataAsync" @ref="_dataGrid" GridLines="DataGridGridLines.None" AllowSorting="true" SelectionMode="DataGridSelectionMode.Single" RowSelect="OnRowSelect" IsLoading="_isLoading">
        <EmptyTemplate>
            <p style="color: lightgrey; font-size: 24px; text-align: center; margin: 2rem;">No records to display.</p>
        </EmptyTemplate>
        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Style="width: 100%;">
                <RadzenButton Icon="create_new_folder" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" />
                <RadzenButton Icon="attach_file" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Click="@OpenFileInputAsync" />
                <input type="file" style="display: none" id="file-uploader" />
            </RadzenStack>
        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn Title="" Sortable="false" Width="4rem">
                <Template Context="ctx">
                    @if (ctx.IsContainer)
                    {
                        <img src="images/folder.svg" alt="Container" style="width:24px;height:24px;" />
                    }
                    else
                    {
                        <img src="images/document.svg" alt="Document" style="width:24px;height:24px;" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(DocumentInfo.Name)" Title="Name" SortOrder="SortOrder.Ascending" />
            <RadzenDataGridColumn Property="@nameof(DocumentInfo.ModifiedOn)" Title="Modified On"  />
        </Columns>
    </RadzenDataGrid>
</div>

@code {

    [Parameter]
    public Guid? ContainerId { private get; set; }

    [CascadingParameter(Name = "SubscriptionId")]
    public Guid SubscriptionId { get; set; }

    RadzenDataGrid<DocumentInfo>? _dataGrid;
    RadzenButton? _popupButton;
    InputFile? _fileInput;

    bool _isLoading = true;
    bool _isMenuOpened = false;
    int _count;
    IBrowserFile _file;
    IEnumerable<DocumentInfo>? _items;

    IJSObjectReference? uploader;
    DotNetObjectReference<ContentList>? objRef;

    bool _rendered = false;
    DocumentInfo? _fileDetails;

    protected override async Task OnParametersSetAsync()
    {
        _isMenuOpened = false;
        try
        {
            if (ContainerId.GetValueOrDefault(Guid.Empty) != Guid.Empty)
            {
                _fileDetails = await _fileProvider.GetDetailsAsync(SubscriptionId, ContainerId.Value);

                if (_fileDetails != null)
                {


                }
            }
        }
        catch (Exception)
        {
            throw;
        }

        if (_rendered)
        {
            if (_dataGrid != null)
                await _dataGrid.Reload();
        }

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            uploader ??= await _jsRuntime.InvokeAsync<IJSObjectReference>("import", "./upload.js");
            objRef ??= DotNetObjectReference.Create(this);
            _rendered = true;
        }
    }

    private async Task GetDataAsync(LoadDataArgs args)
    {
        try
        {
            _isLoading = true;
            StateHasChanged();

            SortDescriptor? sort = args.Sorts.FirstOrDefault();
            var query = await _fileProvider.QueryAsync(SubscriptionId, ContainerId, skip: args.Skip ?? 0, take: args.Top ?? 25, orderBy: sort?.Property ?? nameof(DocumentInfo.Name), descending: sort?.SortOrder == SortOrder.Descending, search: null);
            _count = query.TotalCount;
            _items = query.Items ?? [];
        }
        finally
        {

            _isLoading = false;
            StateHasChanged();
        }

    }

    private void OnRowSelect(DocumentInfo args)
    {
        // Handle the row click event, e.g., navigate to the file details page
        if (args.IsContainer)
        {
            // Navigate to Container view
            _navigationManager.NavigateTo($"/view/1/{args.Id}");
        }
        else
        {
            // Open or download the file
        }
    }
    async Task OpenFileInputAsync()
    {
        var httpClient = _factory.CreateClient("backend");
        var uploadUrl = new Uri(httpClient.BaseAddress, $"/dms/api/{SubscriptionId}/documents/upload/stream");

        await (uploader?.InvokeVoidAsync("triggerFileInput", "file-uploader", uploadUrl, ContainerId, objRef) ?? ValueTask.CompletedTask);
    }


    public async ValueTask DisposeAsync()
    {
        if (uploader != null)
            await uploader.DisposeAsync();
    }

    [JSInvokable("onFileUploadCompleted")]
    public async Task OnFileUploadCompleted(bool success)
    {
        _count = 0;
        _items = null;

        if (success)
        {
            
        }
        await _dataGrid?.Reload();
    }
}
<style>
    .rz-custom-header {
        width: 100%;
    }
</style>