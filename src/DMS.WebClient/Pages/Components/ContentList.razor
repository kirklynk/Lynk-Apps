@using System.Dynamic
@using MudBlazor
@implements IDisposable
@inject ILogger<ContentList> _logger

@inject IHttpClientFactory _factory

<PageHeader Title="@Title">
    <HeaderContent>
        <div>
            <MudBreadcrumbs Items="_breadcrumbs" />
        </div>
        <div>
            <MudText HtmlTag="h2" Style="font-size: 2rem; padding-left: 10px;">
                @Title
            </MudText>
        </div>
    </HeaderContent>
    <ChildContent>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudMenu Style="padding: 0.5rem; width: 100%;" AnchorOrigin="Origin.BottomLeft" Color="Color.Primary">
                <ActivatorContent>
                    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Medium" Label="Create or upload" Class="hide-button-small" />
                    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Class="show-button-small" />
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Label="New Container" Icon="@Icons.Material.Filled.Folder" OnClick="OpenNewContainerDialogAsync" />
                    <MudMenuItem Label="Upload files" Disabled="_isUploading" Icon="@Icons.Material.Filled.UploadFile" OnClick="@(async args => await OpenFileUploaderAsync(ContainerId))" />
                </ChildContent>
            </MudMenu>
            <MudTextField Value="_search" Placeholder="Search files..." Adornment="Adornment.End" T="string" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Immediate="true" ValueChanged="@(async (x) => { _search = x; await _dataGrid!.ReloadServerData(); })" Style="width: 200px;" Clearable="true" InputType="InputType.Search" DebounceInterval="500" Variant="Variant.Text" />
        </MudStack>
        <input type="file" style="display:none" id="lynk-file-upload" @ref="_fileInput" @onchange="FileInputChanged" multiple />
    </ChildContent>
</PageHeader>
@if (_isUploading)
{
    <div>
        <MudStack>
            <MudProgressLinear Color="Color.Primary" Size="Size.Large" Indeterminate="false" Value="@(_percentage * 1.00)" />

            <MudText Typo="Typo.subtitle2">Please do not close this page while upload is in progress.</MudText>
            <MudGrid>
                @foreach (var item in _filesBeingUploaded)
                {
                    <MudItem xs="6">
                        @item.Name
                    </MudItem>
                    <MudItem xs="6" Style="text-align: right;">
                        @item.Status (@item.Progress%)
                    </MudItem>
                }
            </MudGrid>
        </MudStack>
    </div>
}
else
{
    <MudDataGrid T="DocumentInfo" MultiSelection="true" Bordered="false" FixedHeader="true" Virtualize="true" Outlined="false" ItemSize="10.0f" SortMode="SortMode.Single" Loading="@_isLoading" Elevation="0" RowClass="row" VirtualizeServerData="GetDataAsync" Height="500px" RowClick="RowClicked" Dense="true" @ref="_dataGrid">
        <Columns>
            <TemplateColumn CellStyle="width: 24px;" Context="ctx" HideSmall="true">
                <CellTemplate>
                    @if (ctx.Item.IsContainer)
                    {
                        <img src="images/folder.svg" alt="Container" style="width:24px;height:24px;" />
                    }
                    else
                    {
                        <img src="images/document.svg" alt="Document" style="width:24px;height:24px;" />
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn SortBy="x => x.Name" Context="ctx" Sortable="true" Title="Name" CellClass="justify-start">
                <CellTemplate>
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        @($"{ctx.Item.Name}{ctx.Item.Extension}")
                        @if (ctx.Item.IsPinned == true)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.PushPin" Color="Color.Error" aria-describedby="@($"{ctx.Item.Name} pinned")" Title="Pinned" />
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.ModifiedOn" Title="Modified On" SortBy="x => x.IsContainer" HideSmall="true" CellStyle="width: 200px;" Hideable="true" />
            <TemplateColumn Context="ctx" HideSmall="true" Hideable="true" Title="Size" CellStyle="width: 120px;">
                <CellTemplate>
                    @if (!ctx.Item.IsContainer)
                    {
                        <text>@ctx.Item.Size.FormatFileSize()</text>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn CellStyle="width: 24px;" Context="ctx">
                <CellTemplate>
                    <MudMenu AnchorOrigin="Origin.CenterLeft" Color="Color.Primary">
                        <ActivatorContent>
                            <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" />
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem Label="Delete" Icon="@Icons.Material.Filled.Delete" OnClick="@(async () => await DeleteAsync(ctx.Item.Id))" />

                            @* <MudMenuItem Label="Rename" Icon="@Icons.Material.Filled.TextFields" />

                         <MudMenuItem Label="Share"  Icon="@Icons.Material.Filled.Share" OnClick="@(async () => await ShareAsync(ctx.Item))" /> *@

                            <MudMenuItem Label="@(ctx.Item.IsPinned == true ? "Unpin" : "Pin")" Icon="@Icons.Material.Filled.PushPin" IconColor="@(ctx.Item.IsPinned == true ? Color.Error : Color.Default)" OnClick="@(async () => await TogglePinnedAsync(ctx.Item))" />

                            @if (ctx.Item.IsContainer)
                            {
                                <MudMenuItem Label="Upload files" Icon="@Icons.Material.Filled.UploadFile" OnClick="@(async args => await OpenFileUploaderAsync(ctx.Item.Id))" />
                            }
                            else
                            {
                                <MudMenuItem Label="Download" Icon="@Icons.Material.Filled.FileDownload" OnClick="@(async args => await DownloadFileAsync(ctx.Item.Id))" />
                            }

                        </ChildContent>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <EmptyContent />
        </NoRecordsContent>
    </MudDataGrid>
}
<MudMessageBox @ref="_mudMessageBox" Title="Warning" CancelText="Cancel">
    <MessageContent>
        Are you sure you want to move this item to the recycle bin, you will have 30 days to recover it?
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error"> Delete</MudButton>
    </YesButton>
</MudMessageBox>

@code {

    [Parameter]
    public Guid? ContainerId { private get; set; }

    [CascadingParameter(Name = "SubscriptionId")]
    public Guid SubscriptionId { get; set; }

    [CascadingParameter(Name = "UserId")]
    public Guid UserId { get; set; }

    List<BreadcrumbItem> _breadcrumbs = new() { new("Root", $"/", icon: Icons.Material.Filled.Home), new BreadcrumbItem(_defaultTitle, $"/view/1/", icon: Icons.Material.Filled.Folder) };

    ElementReference _fileInput;
    MudDataGrid<DocumentInfo>? _dataGrid;

    IJSObjectReference _uploader;
    DotNetObjectReference<ContentList>? objRef;
    ContainerInfo? _container = null;
    MudMessageBox? _mudMessageBox;

    bool _isLoading = true;
    bool _isUploading = false;
    int _percentage = 0;
    string? _search = null;
    List<UploadInfo> _filesBeingUploaded = [];
    string Title => _container != null ? _container.Name : _defaultTitle;
    const string _defaultTitle = "My Files";

    protected override async Task OnParametersSetAsync()
    {
        _container = null;
        _logger.LogInformation("OnParametersSetAsync called with ContainerId: {ContainerId}", ContainerId);
        _breadcrumbs = new() { new("", $"/", icon: Icons.Material.Filled.Home) };
        _breadcrumbs.Add(new(_defaultTitle, $"/view/0", disabled: !ContainerId.HasValue));

        if (ContainerId.HasValue)
        {
            var results = await _fileProvider.GetRelatedContainersAsync(UserId, SubscriptionId, ContainerId.Value);
            _container = results.FirstOrDefault();
            foreach (var container in results.Reverse<ContainerInfo>())
            {
                _breadcrumbs.Add(new(container.Name, $"/view/1/{container.Id}", disabled: container.Id == _container?.Id));
            }
        }

        if (_dataGrid != null)
        {
            await _dataGrid!.ReloadServerData();
        }
        await base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _logger.LogInformation("OnAfterRenderAsync firstRender: {FirstRender}", firstRender);
            _uploader ??= await _jsRuntime.InvokeAsync<IJSObjectReference>("import", "./upload.js");
            objRef ??= DotNetObjectReference.Create(this);
        }
    }

    private async Task RowClicked(DataGridRowClickEventArgs<DocumentInfo> args)
    {
        var item = args.Item;
        // Handle the row click event, e.g., navigate to the file details page
        if (item.IsContainer)
        {
            // Navigate to Container view
            _navigationManager.NavigateTo($"/view/1/{item.Id}");
        }
        else
        {
            // Open or download the file
        }
    }

    private async Task<GridData<DocumentInfo>> GetDataAsync(GridStateVirtualize<DocumentInfo> request, CancellationToken token)
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var sort = request.SortDefinitions.FirstOrDefault();
            var sortBy = sort?.SortBy ?? string.Empty;
            if (Guid.TryParse(sortBy, out var sortGuid))
            {
                sortBy = _dataGrid!.RenderedColumns.FirstOrDefault(c => c.PropertyName == sortBy)!.Title;
            }

            var query = await _fileProvider.QueryAsync(UserId, SubscriptionId, ContainerId, request.StartIndex, request.Count, search: _search, orderBy: sortBy, descending: sort?.Descending ?? false, cancellationToken: token);

            return new GridData<DocumentInfo>
            {
                Items = query.Items ?? [],
                TotalItems = query.TotalCount
            };
        }
        catch (Exception ex)
        {

        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }

        return new GridData<DocumentInfo>
        {
            Items = [],
            TotalItems = 0
        };
    }

    private async Task OpenNewContainerDialogAsync()
    {
        var result = await _dialogService.ShowAsync<NewContainerForm>("New Container",
            new DialogParameters<NewContainerForm>() { { x => x.SubscriptionId, SubscriptionId }, { x => x.ContainerId, ContainerId }, { x => x.UserId, UserId } },
            new DialogOptions
            {
                CloseOnEscapeKey = true,
                NoHeader = true,
                FullWidth = true,
                MaxWidth = MaxWidth.Small,
                Position = DialogPosition.Center
            });

        var fileDetails = await result.GetReturnValueAsync<DocumentInfo>();
        if (fileDetails != null)
        {
            if (_dataGrid != null)
            {
                await _dataGrid.ReloadServerData();
                StateHasChanged();
            }
        }
    }

    private async Task DeleteAsync(Guid item)
    {
        if (_mudMessageBox != null)
        {
            var result = await _mudMessageBox.ShowAsync();
            if (result == true)
            {
                await _fileProvider.DeleteAsync(UserId, SubscriptionId, item);
                _snackbar?.Clear();

                _snackbar?.Add("Item deleted successfully.", Severity.Success);

                if (_dataGrid != null)
                {
                    await _dataGrid.ReloadServerData();
                }
            }
        }
    }

    private async Task TogglePinnedAsync(DocumentInfo item)
    {
        if (item.IsPinned == true)
        {
            await _fileProvider.UnpinAsync(UserId, SubscriptionId, new List<PinRequest> { new PinRequest { ReferenceId = item.Id, Entity = item.IsContainer ? EntityType.Container : EntityType.Document } });
            item.IsPinned = false;
        }
        else
        {
            await _fileProvider.PinAsync(UserId, SubscriptionId, new PinRequest { ReferenceId = item.Id, Entity = item.IsContainer ? EntityType.Container : EntityType.Document });
            item.IsPinned = true;
        }

        if (_dataGrid != null)
        {
            await _dataGrid.ReloadServerData();
        }
        StateHasChanged();
    }

    private async Task OpenFileUploaderAsync(Guid? containerId)
    {
        await _uploader.InvokeVoidAsync("openFileInput", _fileInput, containerId);
        _isUploading = false;
        _percentage = 0;
        StateHasChanged();
    }

    private async Task FileInputChanged(ChangeEventArgs args)
    {
        var httpClient = _factory.CreateClient("backend");
        var uploadUrl = new Uri(httpClient.BaseAddress, $"/dms/api/users/{UserId}/subscriptions/{SubscriptionId}/documents/upload/stream");
        await _uploader.InvokeVoidAsync("uploadAsync", _fileInput, uploadUrl.ToString(), objRef);
        _isUploading = true;
        StateHasChanged();
    }


    private async Task ShareAsync(DocumentInfo documentInfo)
    {
        var dialog = await _dialogService.ShowAsync<ShareDialog>("Share Document",
            new DialogParameters<ShareDialog>() { { x => x.Info, documentInfo } },
            new DialogOptions
            {
                CloseOnEscapeKey = true,
                NoHeader = true,
                MaxWidth = MaxWidth.Medium,
                Position = DialogPosition.Center,
                CloseButton = true
            });
    }

    [JSInvokable("onUploadStarted")]
    public Task UploadStart(List<UploadInfo> files)
    {
        _filesBeingUploaded = files;
        _isUploading = true;
        _percentage = 0;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable("onFileUploadCompleted")]
    public async Task OnFileUploadCompleted()
    {
        await _dataGrid!.ReloadServerData();
        _isUploading = false;
        _percentage = 0;
        _filesBeingUploaded = [];
        StateHasChanged();
    }

    [JSInvokable("updateProgress")]
    public async Task UpdateProgress(string file, string status, int? percentage)
    {
        var uploadInfo = _filesBeingUploaded.FirstOrDefault(f => f.Name == file);
        if (uploadInfo != null)
        {
            uploadInfo.Status = status;
            if (percentage.HasValue)
                uploadInfo.Progress = (int)percentage;
        }
        _percentage = percentage ?? _percentage;
        _logger.LogInformation("Upload progress updated: {Percentage}%", _percentage);
        _isUploading = true;
        StateHasChanged();
    }

    [JSInvokable("onFileUploaded")]
    public async Task OnFileUploaded(string file, string status)
    {
        var uploadInfo = _filesBeingUploaded.FirstOrDefault(f => f.Name == file);
        if (uploadInfo != null)
        {
            uploadInfo.Status = status;
        }
        StateHasChanged();
    }


    [JSInvokable("resetProgress")]
    public async Task ResetProgress()
    {
        _filesBeingUploaded = [];
        _percentage = 0;
        _isUploading = false;
        StateHasChanged();
    }

    private async Task DownloadFileAsync(Guid documentId)
    {
        var httpClient = _factory.CreateClient("backend");
        var uploadUrl = new Uri(httpClient.BaseAddress, $"/dms/api/users/{UserId}/subscriptions/{SubscriptionId}/documents/{documentId}/download");
        await _jsRuntime.InvokeVoidAsync("download", uploadUrl.ToString());
    }

    public void Dispose()
    {
        _uploader?.DisposeAsync();
    }

    public class UploadInfo
    {
        public string Name { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public int Progress { get; set; } = 0;
    }
}
<style>

    @@media (max-width: 600px) {
        .hide-button-small {
            display: none;
        }

        .show-button-small {
            display: flex;
        }

        .mud-xs-table .mud-table-cell-hide {
            visibility: collapse;
            height: 0;
            padding: 0;
            margin: 0;
            display: none;
        }
    }

    @@media (min-width: 600px) {
        .hide-button-small {
            display: flex;
        }

        .show-button-small {
            display: none;
        }
    }
</style>