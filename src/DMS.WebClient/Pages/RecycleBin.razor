@page "/view/3"
@inject ILogger<RecycleBin> _logger
@implements IDisposable

<PageHeader Title="@Title">
    <HeaderContent>
        <MudBreadcrumbs Items="@([new BreadcrumbItem("", href: "/", icon: Icons.Material.Filled.Home), new BreadcrumbItem(Title, href: "/view/3", disabled: true)])"></MudBreadcrumbs>
        <MudText Style="font-size: 2rem; padding-left: 10px;">@Title</MudText>
    </HeaderContent>
    <ChildContent>
        <MudStack Row="true" Class="fullwidth" Style="width: 100%;" Gap="2">
            @if (_selected.Count == 0)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" DropShadow="true" OnClick="EmptyRecycleBinAsync" StartIcon="@Icons.Material.Outlined.Warning" Disabled="_isEmpty">Empty Recycle Bin</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Restore" DropShadow="true" OnClick="@(async () => await RestorePurgeAsync(new RecycleBinItem() { Items = _selected.Select(x => x.Id).ToList() }))">Restore</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.DeleteForever" DropShadow="true" OnClick="@(async () => await RestorePurgeAsync(new RecycleBinItem() { Items = _selected.Select(x => x.Id).ToList() }, true))">Delete</MudButton>
            }
        </MudStack>
    </ChildContent>
</PageHeader>

<div style="margin-top: 20px;">
    <MudDataGrid MultiSelection="true" T="DocumentInfo" Bordered="false" SelectedItems="_selected" FixedHeader="true" Virtualize="true" Outlined="false" ItemSize="20.0f" SortMode="SortMode.Single" Loading="@_isLoading" Height="500px" RowClass="row" VirtualizeServerData="GetDataAsync" @ref="_dataGrid" SelectOnRowClick="true" SelectedItemsChanged="@(() => StateHasChanged())" SelectedItemChanged="@(() => StateHasChanged())">
        <Columns>
            <SelectColumn ShowInHeader="false" />
            <TemplateColumn CellStyle="width: 24px;">
                <CellTemplate>
                    @if (context.Item.IsContainer)
                    {
                        <img src="images/folder.svg" alt="Container" style="width:24px;height:24px;" />
                    }
                    else
                    {
                        <img src="images/document.svg" alt="Document" style="width:24px;height:24px;" />
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Name" SortBy="x => x.IsContainer" />
            <TemplateColumn Title="Deleted On" UserAttributes="@(new() { { "title", "Deleted On" } })" SortBy="x => x.IsContainer">
                <CellTemplate>
                    @{
                        var time = context!.Item!.DeletedOn!.Value.Add(TimeOffset);
                        <text>@time.ToString("g")</text>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn CellStyle="width: 24px;">
                <CellTemplate>
                    <MudMenu AnchorOrigin="Origin.CenterLeft" Color="Color.Primary" Disabled="_dataGrid?.SelectedItems.Count > 0">
                        <ActivatorContent>
                            <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" />
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem Label="Restore" Icon="@Icons.Material.Filled.Restore" OnClick="@(async () => await RestorePurgeAsync(new RecycleBinItem() { Items = new List<Guid> { context.Item.Id } }))" />

                        </ChildContent>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>

        </Columns>
        <NoRecordsContent>
            <EmptyContent />
        </NoRecordsContent>
    </MudDataGrid>
</div>

<MudMessageBox @ref="_mudMessageBox" Title="Empty recycle bin" CancelText="Cancel">
    <MessageContent>
        Are you sure you want to permanently delete all these items?
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error"> Delete</MudButton>
    </YesButton>
</MudMessageBox>

@code {

    [CascadingParameter(Name = "SubscriptionId")]
    public Guid SubscriptionId { get; set; }

    [CascadingParameter(Name = "TimeOffset")]
    public TimeSpan TimeOffset { get; set; }

    [CascadingParameter(Name = "UserId")]
    public Guid UserId { get; set; }

    MudDataGrid<DocumentInfo>? _dataGrid;
    MudMessageBox? _mudMessageBox;
    bool _isLoading = true;
    bool _isEmpty = true;
    HashSet<DocumentInfo> _selected = [];
    string Title => "Recycle Bin";

    CancellationTokenSource _cts = new();
    async Task<GridData<DocumentInfo>> GetDataAsync(GridStateVirtualize<DocumentInfo> request, CancellationToken token)
    {
        _isLoading = true;
        _isEmpty = true;
        StateHasChanged();

        try
        {

            var sort = request.SortDefinitions.FirstOrDefault();

            var query = await _fileProvider.QueryDeletedAsync(UserId, SubscriptionId, skip: request.StartIndex, take: request.Count, orderBy: sort?.SortBy, descending: sort != null ? !sort.Descending : false, cancellationToken: token);
            _isEmpty = query.TotalCount == 0;
            return new GridData<DocumentInfo>
            {
                Items = query.Items ?? [],
                TotalItems = query.TotalCount
            };
        }
        catch (Exception ex)
        {
            if (ex is not OperationCanceledException)
            {
                _snackbar?.Add($"Error loading recycle bin items.", Severity.Error);
            }
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }

        return new GridData<DocumentInfo>
        {
            Items = [],
            TotalItems = 0
        };
    }

    async Task RestorePurgeAsync(RecycleBinItem restore, bool shouldPurge = false)
    {
        _snackbar?.Clear();

        var action = shouldPurge ? "purged" : "restored";
        try
        {
            if (shouldPurge)
            {
                var result = await _mudMessageBox.ShowAsync();
                if (result != true)
                    return;

                await _fileProvider.PurgeRecycleBinItemsAsync(UserId, SubscriptionId, restore, _cts.Token);
            }
            else
            {
                var result = await _dialogService.ShowMessageBox(
                    "Restore items",
                    "Are you sure you want to restore the selected items?",
                    yesText: "Restore",
                    cancelText: "Cancel");

                if (result != true)
                    return;

                await _fileProvider.RestoreAsync(UserId, SubscriptionId, restore, _cts.Token);
            }

            _isLoading = true;
            _selected.Clear();
            StateHasChanged();

            _snackbar?.Add($"Items {action} successfully.", Severity.Success);

            if (_dataGrid != null)
            {
                await _dataGrid.ReloadServerData();
            }
        }
        catch (Exception ex)
        {
            _snackbar?.Add($"An error occurred while {action} items.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    async Task EmptyRecycleBinAsync()
    {
        if (_mudMessageBox != null)
        {
            var result = await _mudMessageBox.ShowAsync();
            if (result == true)
            {
                _selected?.Clear();
                await _fileProvider.EmptyRecycleBinAsync(UserId, SubscriptionId, _cts.Token);
                await _dataGrid!.ReloadServerData();
            }
            StateHasChanged();
        }
    }
}
