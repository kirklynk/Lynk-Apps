@page "/recyclebin"
@inject ILogger<RecycleBin> _logger

<MudPaper Elevation="0" Style="margin-bottom: 5px;">
    <MudBreadcrumbs Items="@([new BreadcrumbItem("", href: "/", icon: Icons.Material.Filled.Home), new BreadcrumbItem("Recycle Bin", href: "/recyclebin", disabled: true)])"></MudBreadcrumbs>
    <MudText Style="font-size: 20px; padding-left: 10px;">Recycle bin</MudText>
</MudPaper>

<p class="mb-4">
    <MudStack Row="true" Class="fullwidth" Style="width: 100%;">
        <MudButton Variant="Variant.Filled" Color="Color.Default" DropShadow="true" OnClick="EmptyRecycleBinAsync" Disabled="_isEmpty">Empty recycle bin</MudButton>
        @if (_selected.Count > 0)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Default" StartIcon="@Icons.Material.Outlined.Restore" DropShadow="true" OnClick="@(async () => await RestorePurgeAsync(new RecycleBinItem() { Items = _selected.Select(x => x.Id).ToList() }))">Restore selected</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Default" StartIcon="@Icons.Material.Outlined.DeleteForever" DropShadow="true" OnClick="@(async () => await RestorePurgeAsync(new RecycleBinItem() { Items = _selected.Select(x => x.Id).ToList() }, true))">Delete selected</MudButton>
        }
    </MudStack>
</p>

<div>
    <MudDataGrid MultiSelection="true" T="DocumentInfo" Bordered="false" SelectedItems="_selected" FixedHeader="true" Virtualize="true" Outlined="false" ItemSize="20.0f" SortMode="SortMode.Single" Loading="@_isLoading" Height="500px" RowClass="row" VirtualizeServerData="GetDataAsync" @ref="_dataGrid" SelectOnRowClick="true" SelectedItemsChanged="@(() => StateHasChanged())" SelectedItemChanged="@(() => StateHasChanged())">
        <Columns>
            <SelectColumn ShowInHeader="false" T="DocumentInfo" />
            <TemplateColumn CellStyle="width: 24px;">
                <CellTemplate>
                    @if (context.Item.IsContainer)
                    {
                        <img src="images/folder.svg" alt="Container" style="width:24px;height:24px;" />
                    }
                    else
                    {
                        <img src="images/document.svg" alt="Document" style="width:24px;height:24px;" />
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Name" SortBy="x => x.IsContainer" />
            <PropertyColumn Property="x => x.DeletedOn" SortBy="x => x.IsContainer" />
            <TemplateColumn CellStyle="width: 24px;">
                <CellTemplate>
                    <MudMenu AnchorOrigin="Origin.CenterLeft" Color="Color.Primary" Disabled="_dataGrid?.SelectedItems.Count > 0">
                        <ActivatorContent>
                            <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" />
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem Label="Restore" Icon="@Icons.Material.Filled.Restore" OnClick="@(async () => await RestorePurgeAsync(new RecycleBinItem() { Items = new List<Guid> { context.Item.Id } }))" />

                        </ChildContent>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <EmptyContent>
                The recycle bin is empty.
            </EmptyContent>
        </NoRecordsContent>
        <Header>
        </Header>
    </MudDataGrid>
</div>

<MudMessageBox @ref="_mudMessageBox" Title="Empty recycle bin" CancelText="Cancel">
    <MessageContent>
        Are you sure you want to permanently delete all these items?
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error"> Delete</MudButton>
    </YesButton>
</MudMessageBox>

@code {

    [CascadingParameter(Name = "SubscriptionId")]
    public Guid SubscriptionId { get; set; }

    MudDataGrid<DocumentInfo>? _dataGrid;
    MudMessageBox? _mudMessageBox;
    bool _isLoading = true;
    bool _isEmpty = true;
    HashSet<DocumentInfo> _selected = [];

    async Task<GridData<DocumentInfo>> GetDataAsync(GridStateVirtualize<DocumentInfo> request, CancellationToken token)
    {
        _isLoading = true;
        _isEmpty = true;
        StateHasChanged();

        try
        {

            var sort = request.SortDefinitions.FirstOrDefault();

            var query = await _fileProvider.QueryDeletedAsync(SubscriptionId, skip: request.StartIndex, take: request.Count, orderBy: sort?.SortBy, descending: sort != null ? !sort.Descending : false);
            _isEmpty = query.TotalCount == 0;
            return new GridData<DocumentInfo>
            {
                Items = query.Items ?? [],
                TotalItems = query.TotalCount
            };
        }
        catch (Exception ex)
        {

        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }

        return new GridData<DocumentInfo>
        {
            Items = [],
            TotalItems = 0
        };
    }

    async Task RestorePurgeAsync(RecycleBinItem restore, bool shouldPurge = false)
    {
        _isLoading = true;
        _selected.Clear();
        StateHasChanged();
        _snackbar?.Clear();
        _snackbar?.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
        try
        {
            if (shouldPurge)
            {
                var result = await _mudMessageBox.ShowAsync();
                if (result == true)
                {
                    await _fileProvider.PurgeRecycleBinItemsAsync(SubscriptionId, restore);
                }
                else
                {
                    return;
                }
            }
            else
                await _fileProvider.RestoreAsync(SubscriptionId, restore);
            var action = shouldPurge ? "purged" : "restored";

            _snackbar?.Add($"Items {action} successfully.", Severity.Success, configure: op =>
                {
                    op.VisibleStateDuration = 1500;
                });
            if (_dataGrid != null)
            {
                await _dataGrid.ReloadServerData();
            }
        }
        catch (Exception ex)
        {
            _snackbar?.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    async Task EmptyRecycleBinAsync()
    {
        if (_mudMessageBox != null)
        {
            var result = await _mudMessageBox.ShowAsync();
            if (result == true)
            {
                await _fileProvider.EmptyRecycleBinAsync(SubscriptionId);
                await _dataGrid!.ReloadServerData();
            }
            StateHasChanged();
        }
    }
}
