@page "/login"
@using Shared.Models
@layout AuthenticationLayout

@attribute [AllowAnonymous]

<EditForm Model="_loginRequest" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <div style="width: 400px; width: 100%; margin: 2rem auto;">
        <MudCard Style="padding: 1rem; width: 350px;" Elevation="2" Square="true">
            <div>
                <MudText Style="text-align: center; width: 100%;" Color="Color.Tertiary">Lynk DMS</MudText>
            </div>
            <div style="margin-top: 1rem;">
                <MudTextField Style="width: 100%;" Placeholder="Email" @bind-Value="_loginRequest.Email" Name="Email" AutoFocus="true" />
                <ValidationMessage For="@(() => _loginRequest.Email)" />
            </div>
            <div style="margin-top: 1rem;">
                <MudTextField Style="width: 100%;" Placeholder="Password" @bind-Value="_loginRequest.Password"  Name="Password" InputType="InputType.Password" />
                <ValidationMessage For="@(() => _loginRequest.Password)" />
            </div>
            <div style="margin-top: 1rem; text-align: right;">
                <MudButton ButtonType="ButtonType.Submit" Style="width: 100%;">Login</MudButton>
            </div>
        </MudCard>
    </div>
</EditForm>

@code {
    private LoginModel _loginRequest = new();

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private async Task HandleValidSubmit()
    {
        var result = await _accountManagement.LoginAsync(_loginRequest);
        if (result)
        {
            _navigationManager.NavigateTo(ReturnUrl ?? "/", true);
        }
        else
        {
            // Handle failed login
        }
    }
}
