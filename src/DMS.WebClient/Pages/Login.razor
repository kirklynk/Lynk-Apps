@page "/login"
@layout AuthenticationLayout

@attribute [AllowAnonymous]


<EditForm Model="_loginRequest" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <div style="max-width: 400px; width: 100%; margin: 2rem auto;">
        <RadzenCard>
            <div>
                <RadzenHeading Size="H4" Style="text-align: center; width: 100%;">Login to your account</RadzenHeading>
            </div>
            <div style="margin-top: 1rem;">
                <RadzenTextBox Style="width: 100%;" Placeholder="Email" @bind-Value="_loginRequest.Email" Name="Email" />
                <ValidationMessage For="@(() => _loginRequest.Email)" />
            </div>
            <div style="margin-top: 1rem;">
                <RadzenTextBox Style="width: 100%;" Placeholder="Password" @bind-Value="_loginRequest.Password" Name="Password" Type="Password" />
                <ValidationMessage For="@(() => _loginRequest.Password)" />
            </div>
            <div style="margin-top: 1rem; text-align: right;">
                <RadzenButton ButtonType="ButtonType.Submit" Style="width: 100%;">Login</RadzenButton>
            </div>
        </RadzenCard>
    </div>
</EditForm>

@code {
    private LoginRequest _loginRequest = new();

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private async Task HandleValidSubmit()
    {
        var result = await _accountManagement.LoginAsync(_loginRequest);
        if (result)
        {
            _navigationManager.NavigateTo(ReturnUrl ?? "/", true);
        }
        else
        {
            // Handle failed login
        }
    }
}
