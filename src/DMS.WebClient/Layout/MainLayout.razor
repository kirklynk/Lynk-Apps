@inherits LayoutComponentBase
<HeadContent>
    <RadzenTheme Theme="material" />
</HeadContent>

<CascadingValue Value="SubscriptionId" Name="SubscriptionId">
    <CascadingValue Value="ContainerId" Name="ContainerId">
        <RadzenLayout>
            <RadzenHeader>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
                    <RadzenSidebarToggle Click="DrawerToggle" />
                    <RadzenLabel Text="Header" />
                </RadzenStack>
            </RadzenHeader>
            <RadzenSidebar Responsive="false" Style="width: max-content">
                <RadzenPanelMenu DisplayStyle="@(!_drawerOpen ? MenuItemDisplayStyle.IconAndText : MenuItemDisplayStyle.Icon)" ShowArrow="false">
                    <RadzenPanelMenuItem Text="Overview" Icon="apps" Path="/" Match="NavLinkMatch.All" />
                    <RadzenPanelMenuItem Text="Dashboard" Icon="delete" />
                  
                </RadzenPanelMenu>
            </RadzenSidebar>
            <RadzenBody>
                <div class="rz-p-4">
                    @Body
                </div>
            </RadzenBody>
        </RadzenLayout>

    </CascadingValue>
</CascadingValue>
<RadzenComponents />

@code {

    bool _drawerOpen = false;

    public Guid? ContainerId { get; set; }

    public Guid SubscriptionId { get; } = Guid.Parse("CC2A839C-C7A7-4770-AFB9-AAD4054CEA31");

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    async Task LogoutAsync()
    {
        await _accountManagement.LogoutAsync();
    }
}

