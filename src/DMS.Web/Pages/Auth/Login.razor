@page "/account/login"


<EditForm Model="_loginRequest" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <div style="max-width: 400px; width: 100%; margin: 2rem auto;">
        <MudCard>
            <div>
                <MudText Size="H4" Style="text-align: center; width: 100%;">Login to your account</MudText>
            </div>
            <div style="margin-top: 1rem;">
                <MudTextField Style="width: 100%;" Placeholder="Email" @bind-Value="_loginRequest.Email" Name="Email" />
                <ValidationMessage For="@(() => _loginRequest.Email)" />
            </div>
            <div style="margin-top: 1rem;">
                <MudTextField Style="width: 100%;" Placeholder="Password" @bind-Value="_loginRequest.Password" Name="Password" Type="Password" />
                <ValidationMessage For="@(() => _loginRequest.Password)" />
            </div>
            <div style="margin-top: 1rem; text-align: right;">
                <MudButton ButtonType="ButtonType.Submit" Style="width: 100%;">Login</MudButton>
            </div>
        </MudCard>
    </div>
</EditForm>

@code {
    private LoginRequest _loginRequest = new();

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

