@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<CascadingValue Value="SubscriptionId" Name="SubscriptionId">
    <CascadingValue Value="ContainerId" Name="ContainerId">
        <MudLayout>
            <MudAppBar Elevation="1" Class="menu-background">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
                <MudText Typo="Typo.h5" Class="ml-3">Lynk Cloud Sync</MudText>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Edge="Edge.End" OnClick="LogoutAsync" />
            </MudAppBar>
            <AuthorizeView>
                <Authorized>
                    <MudDrawer Class="menu-background" @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Mini">
                        <MudSpacer />
                        <MudNavMenu>
                            <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Apps" Href="/" ForceLoad="true">My Files</MudNavLink>
                            <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Delete" Href="/trash">Trash</MudNavLink>
                        </MudNavMenu>
                        <MudSpacer />
                        <MudNavMenu>
                            <MudNavLink Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings" Href="/settings">Settings</MudNavLink>
                        </MudNavMenu>
                    </MudDrawer>
                </Authorized>
            </AuthorizeView>
            <MudMainContent>
                <div style="padding: 2rem;">
                    @Body
                </div>
            </MudMainContent>
        </MudLayout>
    </CascadingValue>
</CascadingValue>


@code {

    bool _drawerOpen = false;

    public Guid? ContainerId { get; set; }

    public Guid SubscriptionId { get; } = Guid.Parse("CC2A839C-C7A7-4770-AFB9-AAD4054CEA31");

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    async Task LogoutAsync()
    {
        //await _accountManagement.LogoutAsync();
    }
}
