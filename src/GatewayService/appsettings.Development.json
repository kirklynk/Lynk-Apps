{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\sqlexpress;Database=UserDbContext;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "ReverseProxy": {
    "Routes": {
      "route1": {
        "ClusterId": "dms-cluster",
        "Match": {
          "Path": "/dms/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/dms" }
        ]
      }
    },
    "Clusters": {
      "dms-cluster": {
        "Destinations": {
          "dms1": {
            "Address": "https://localhost:7255/"
          }
        }
      }
    }
  }
}
